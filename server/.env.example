# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tirtha-yatri?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-secret
