# Server
PORT=5000
NODE_ENV=development

# Frontend origins allowed by CORS
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Demo admin created by the seed script
SEED_ADMIN_EMAIL=admin@tirthayatri.com
